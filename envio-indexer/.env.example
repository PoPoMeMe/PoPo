# Copy to .env. Envio reads RPC overrides from RPC_<ID>.
# Monad testnet chain id = 10143. Public RPC is set in config.yaml; override here.
RPC_10143=https://testnet-rpc.monad.xyz

# Postgres used by HyperIndex (defaults match `envio dev`'s local container).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/envio
